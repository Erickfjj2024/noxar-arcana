# =============================================
# NOXAR ARCANA — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env no GitHub
# Os valores reais ficam no GitHub Secrets e no Render
# =============================================

# GROQ API — obtenha em: console.groq.com
GROQ_API_KEY=

# SUPABASE — obtenha em: supabase.com > Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# FLASK — gere uma string aleatória de 32 caracteres
# Sugestão: acesse uuidgenerator.net e cole aqui
FLASK_SECRET_KEY=

# AMBIENTE
FLASK_ENV=production
PORT=5000

# FRONTEND URL (atualize após deploy no Vercel)
FRONTEND_URL=https://noxar-arcana.vercel.app

# STORAGE
TEMP_VIDEO_DIR=/tmp/noxar_videos
